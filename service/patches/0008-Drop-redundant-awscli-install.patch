From a686ad74f01553fe9a72e55015e43b78cdcb69b2 Mon Sep 17 00:00:00 2001
From: Uzair Akbar <uzairakbar025@gmail.com>
Date: Wed, 1 Jul 2026 10:53:01 -0400
Subject: [PATCH 08/20] Drop redundant awscli install

---
 docker/Dockerfile.build-core | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/docker/Dockerfile.build-core b/docker/Dockerfile.build-core
index 8da181e..f86434b 100644
--- a/docker/Dockerfile.build-core
+++ b/docker/Dockerfile.build-core
@@ -80,11 +80,10 @@ RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-py312_24.7.1-0-Lin
     rm /tmp/miniconda.sh && \
     /root/anaconda/bin/conda init bash
 
-# Install AWS CLI v2
-RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o "awscliv2.zip" \
-    && unzip awscliv2.zip \
-    && ./aws/install \
-    && rm -rf aws awscliv2.zip
+# AWS CLI v2 intentionally NOT installed: the standalone ZMQ sim uses the local
+# filesystem S3 shim (no `aws` calls in the entrypoint) and markov talks S3 via
+# boto3, not the CLI. Verified the full sim + P4 client run with it removed.
+# (~260 MB saved.) Re-add here if a future path shells out to `aws`.
 
 # Copy Bundle
 COPY bundle/ /opt/amazon
-- 
2.47.3

