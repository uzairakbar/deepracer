Bootstrap: localimage
From: deepracer_base.sif

# Bootstrap: docker
# From: uzairakbar/deepracer-test:v0

# All behavior that previous versions patched on top of the legacy
# uzairakbar/deepracer:v0 image is now baked into uzairakbar/deepracer-test:v0,
# built reproducibly from source in the deepracer-simapp repository
# (docker/Dockerfile.zmqsim). No post-build patching is required here.

%environment
    export LC_ALL=C

%runscript
    cd /opt/ml/code/
    exec /bin/bash /opt/ml/code/entrypoint.sh "$@"
